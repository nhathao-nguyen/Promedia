{
  "name": "promedia-client",
  "version": "0.1.0",
  "description": "Promedia desktop client",
  "homepage": "https://github.com/nhathao-nguyen/Promedia",
  "author": {
    "name": "nhathao-nguyen",
    "email": "nhathao-nguyen@users.noreply.github.com"
  },
  "desktopName": "promedia",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --ignoreConfigWarning",
    "build": "electron-vite build --ignoreConfigWarning",
    "preview": "electron-vite preview --ignoreConfigWarning",
    "typecheck": "tsc --build",
    "test": "node --experimental-strip-types --test tests/client.test.mjs",
    "dependency:check": "node scripts/check-dependencies.mjs",
    "dependency:audit": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run test && npm run dependency:check",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:windows": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.promedia.client",
    "productName": "Promedia",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "vi"
    ],
    "extraResources": [
      {
        "from": "build/promedia.ico",
        "to": "promedia.ico"
      }
    ],
    "asar": true,
    "linux": {
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "build/promedia.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
